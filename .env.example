# RPP Market Hub env template

# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Database
# DATABASE_URL=postgresql://...

# App
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Duitku (required in production)
# DUITKU_MERCHANT_CODE=
# DUITKU_API_KEY=
# DUITKU_BASE_URL=https://sandbox.duitku.com
# DUITKU_DEFAULT_PAYMENT_METHOD=SP

# Platform
# PLATFORM_WITHDRAW_FEE_BPS=500
# PLATFORM_MIN_WITHDRAW_IDR=50000
# PLATFORM_ADMIN_USER_IDS=user_xxx,user_yyy

# Mock payments: allowed automatically in non-production.
# In production, mock is OFF unless explicitly set true (dangerous).
# ALLOW_MOCK_PAYMENTS=false
